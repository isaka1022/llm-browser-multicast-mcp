{
  "providers": {
    "gemini": {
      "type": "gemini-api",
      "apiKey": "${GEMINI_API_KEY}",
      "models": ["gemini-2.5-flash", "gemini-2.5-pro"]
    },
    "grok": {
      "type": "grok-api",
      "apiKey": "${XAI_API_KEY}",
      "models": ["grok-3-fast"]
    },
    "gemini-cli": {
      "type": "gemini-cli",
      "models": ["default"]
    },
    "codex-cli": {
      "type": "codex-cli",
      "models": ["default"]
    },
    "claude-cli": {
      "type": "claude-cli",
      "models": ["default"]
    }
  },
  "defaultModels": [
    "gemini-cli/default",
    "claude-cli/default",
    "codex-cli/default"
  ],
  "chairman": "gemini-cli/default",
  "timeoutMs": 300000
}
