{
  "providers": {
    "gemini": {
      "type": "gemini-api",
      "apiKey": "${GEMINI_API_KEY}",
      "models": ["gemini-2.5-flash", "gemini-2.5-pro"]
    },
    "grok": {
      "type": "grok-api",
      "apiKey": "${XAI_API_KEY}",
      "models": ["grok-3-fast"]
    },
    "gemini-cli": {
      "type": "gemini-cli",
      "models": ["default"]
    },
    "codex-cli": {
      "type": "codex-cli",
      "models": ["default"]
    },
    "claude-cli": {
      "type": "claude-cli",
      "models": ["default"]
    },
    "chatgpt": {
      "type": "chatgpt-web",
      "headless": false,
      "models": ["thinking", "auto"]
    },
    "gemini-web": {
      "type": "gemini-web",
      "headless": false,
      "models": ["pro"]
    },
    "claude-web": {
      "type": "claude-web",
      "headless": false,
      "models": ["sonnet"]
    },
    "grok-web": {
      "type": "grok-web",
      "headless": false,
      "models": ["expert", "grok-4.20"]
    }
  },
  "defaultModels": [
    "chatgpt/thinking",
    "gemini-web/pro",
    "claude-web/sonnet",
    "grok-web/expert"
  ],
  "chairman": "claude-cli/default",
  "timeoutMs": 300000
}
